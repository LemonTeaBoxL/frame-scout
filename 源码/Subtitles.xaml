ueSuggestion" Text="建议：—" TextWrapping="Wrap" Foreground="#80D4BB" FontSize="11" Margin="0,5,0,0"/><TextBlock x:Name="CueEvidence" Text="剧本出处：—" Foreground="#F3CA6C" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></ScrollViewer></Grid></Border><GridSplitter Grid.Column="5" Width="5" HorizontalAlignment="Center" Background="#293345" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/><Border x:Name="SubtitlePreviewPane" Grid.Column="6" Background="#181F2D" CornerRadius="8" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="视频预览" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="LinkedVideo" Text="未关联视频" Foreground="#8FA2BD" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel><Button x:Name="FloatSubtitle" Grid.Column="1" Content="↗" FontSize="17" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Top"/></Grid><Border Grid.Row="1" Background="#080C13" CornerRadius="7" ClipToBounds="True"><Grid><MediaElement x:Name="SubPlayer" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform"/><Image x:Name="SubStill" Stretch="Uniform"/><TextBlock x:Name="SubPreviewMessage" Text="选择字幕定位视频；可关联同名或同集视频" Foreground="#8FA2BD" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240" TextAlignment="Center" FontSize="11"/></Grid></Border><StackPanel Grid.Row="2" Margin="0,8,0,0"><WrapPanel><Button x:Name="PrevSrt" Content="上一集"/><Button x:Name="NextSrt" Content="下一集"/><Button x:Name="PlayCue" Content="播放这条前后"/><Button x:Name="PauseCue" Content="暂停"/></WrapPanel><WrapPanel Margin="0,6,0,0"><Button x:Name="LocateCue" Content="定位字幕"/><Button x:Name="OpenVideoPage" Content="视频页打开"/><Button x:Name="AutoLinkVideo" Content="自动关联同名"/><Button x:Name="LinkVideo" Content="手动关联"/></WrapPanel></StackPanel></Grid></Border></Grid><Grid Grid.Row="2" Margin="0,8,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar x:Name="SubProgress" Minimum="0" Maximum="1" Value="0" Height="7" Foreground="#43BEA6" Background="#27344B" VerticalAlignment="Center"/><TextBlock x:Name="SubProgressText" Grid.Column="1" Text="尚未开始 · 0%" Foreground="#8FA2BD" FontSize="11" Margin="12,0,0,0"/></Grid><Expander x:Name="LogPane" Grid.Row="3" Header="处理日志" IsExpanded="True" Foreground="#AABBD1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LogText" IsReadOnly="True" Height="75" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Margin="7,0,0,0"><Button x:Name="ExportLog" Content="导出日志"/><Button x:Name="ClearLog" Content="清空日志" Margin="0,6,8,0"/></StackPanel></Grid></Expander><TextBlock x:Name="SubStatus" Grid.Row="4" Text="拖入 SRT，加载剧本并校对名词。" Foreground="#8FA2BD" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"/></Grid></UserControl>