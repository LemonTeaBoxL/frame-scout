<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#10141E" Foreground="#E7EDF7" FontFamily="Microsoft YaHei UI"><UserControl.Resources><Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="34"/></Style></UserControl.Resources><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border x:Name="SubtitleToolbar" Background="#181F2D" CornerRadius="8" Padding="10" Margin="0,0,0,8"><StackPanel><WrapPanel><Button x:Name="ImportSrt" Content="＋ 添加 SRT"/><Button x:Name="ImportSrtFolder" Content="字幕文件夹"/><Button x:Name="ApiSettings" Content="API 与模型"/><Button x:Name="ExtractNouns" Content="提取名词"/><Button x:Name="EditNouns" Content="名词表"/><Button x:Name="ImportNouns" Content="导入名词" ToolTip="支持 TXT、MD、CSV、TSV、JSON、DOCX、RTF，可多选或拖到此按钮"/><Button x:Name="CheckNouns" Content="开始名词校对" Background="#217B6C"/><Button x:Name="CancelCheck" Content="停止" IsEnabled="False"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="MultiDialogs" Content="多对话分批" Margin="3,0,10,0"/><TextBlock Text="每组" VerticalAlignment="Center"/><TextBox x:Name="BatchFiles" Text="5" Width="42" Margin="5,0,9,0"/><TextBlock Text="并发" VerticalAlignment="Center"/><TextBox x:Name="DialogCount" Text="2" Width="42" Margin="5,0,0,0"/></StackPanel></WrapPanel><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="剧本" VerticalAlignment="Center" Foreground="#8FA2BD" Margin="0,0,8,0"/><TextBox x:Name="ScriptPathBox" Grid.Column="1" AllowDrop="True" ToolTip="拖入 DOCX、TXT、MD，或填写路径后按 Enter／点击加载" MinWidth="150" Padding="7,4"/><Button x:Name="PickScript" Grid.Column="2" Content="选择…" Margin="7,0,7,0" Padding="10,4"/><Button x:Name="LoadScriptPath" Grid.Column="3" Content="加载路径" Padding="10,4" Margin="0"/></Grid><WrapPanel Margin="0,7,0,0"><Button x:Name="RemoveSrt" Content="移除选中"/><Button x:Name="ClearAllSrt" Content="清空全部" ToolTip="移除全部字幕素材，保留剧本、名词表和 API"/><Button x:Name="AcceptOne" Content="采纳所选"/><Button x:Name="AcceptCertain" Content="采纳确定项"/><Button x:Name="UndoChange" Content="撤销采纳"/><Button x:Name="PreviewChanges" Content="修改预览"/><Button x:Name="ViewSource" Content="查看出处"/><Button x:Name="SaveSrt" Content="另存校对版 SRT"/><Button x:Name="ExportSubReport" Content="导出报告"/><TextBlock x:Name="NounCount" Text="名词表：0 项" Foreground="#8FA2BD" VerticalAlignment="Center" FontSize="11"/></WrapPanel><TextBlock x:Name="TokenNotice" Text="多对话会重复携带名词表与校对说明，可能增加 token 用量及费用。" Foreground="#F3CA6C" TextWrapping="Wrap" Visibility="Collapsed" FontSize="11" Margin="0,5,0,0"/><WrapPanel Margin="0,5,0,0"><TextBlock x:Name="ScriptInfo" Text="剧本未加载 · 支持 DOCX / TXT / MD" Foreground="#8FA2BD" FontSize="10" Margin="0,0,18,0"/><TextBlock x:Name="ApiInfo" Text="API 未配置 · 仅校对专有名词" Foreground="#8FA2BD" FontSize="10"/></WrapPanel></StackPanel></Border><Grid x:Name="SubtitleColumns" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="170"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.05*" MinWidth="190"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.1*" MinWidth="210"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.2*" MinWidth="275"/></Grid.ColumnDefinitions><Border x:Name="SubtitleFilesPane" Grid.Column="0" Background="#181F2D" CornerRadius="8" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="每集字幕" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="FloatSubtitleFiles" Grid.Column="1" Co